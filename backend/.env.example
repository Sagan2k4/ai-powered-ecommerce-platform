# Copy this file to .env (same folder) and fill in your values. .env is git-ignored, never commit it.
# Every line is optional: anything left out falls back to the default in application.yml.

# --- MySQL (default profile only; the dev profile uses an embedded H2 database) ---
DB_URL=jdbc:mysql://localhost:3306/aishop?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- Redis (default profile only) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT: Base64 key of at least 256 bits. Generate one with:
#     python -c "import base64,os;print(base64.b64encode(os.urandom(48)).decode())"
# JWT_SECRET=paste-generated-key-here   (leave commented to use the dev key)

# --- Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys, use Test Mode keys) ---
# Keep RAZORPAY_MOCK=true until you have keys; payments are then simulated.
RAZORPAY_MOCK=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- OpenAI (leave empty to use the built-in recommendation scorer) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Seeded admin account ---
ADMIN_EMAIL=admin@aishop.dev
ADMIN_PASSWORD=Admin@12345
